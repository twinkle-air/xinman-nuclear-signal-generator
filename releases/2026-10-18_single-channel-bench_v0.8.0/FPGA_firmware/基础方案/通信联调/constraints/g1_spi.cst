// ATK-MO8008 V3.3 full 40-pin socket on H5; NOT the old jumper wiring.
IO_LOC "sys_clk" T7;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;
IO_LOC "key_stop_n" F10;
IO_PORT "key_stop_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "dac_clk" C9;
IO_PORT "dac_clk" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[0]" B14;
IO_PORT "dac_data[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[1]" A15;
IO_PORT "dac_data[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[2]" A12;
IO_PORT "dac_data[2]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[3]" B11;
IO_PORT "dac_data[3]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[4]" B12;
IO_PORT "dac_data[4]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[5]" C12;
IO_PORT "dac_data[5]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[6]" C11;
IO_PORT "dac_data[6]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "dac_data[7]" A11;
IO_PORT "dac_data[7]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_LOC "spi_cs_n" G15;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "spi_sck" G14;
IO_PORT "spi_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "spi_mosi" G16;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "spi_miso" H15;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "ready" K14;
IO_PORT "ready" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "irq" K15;
IO_PORT "irq" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "reset_n" K13;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: 编译 Release",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "STM32: ST-Link 烧录",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/flash.ps1"],
      "dependsOn": "STM32: 编译 Release",
      "problemMatcher": []
    }
  ]
}
